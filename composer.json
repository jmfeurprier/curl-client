{
    "name": "jmf/curl-client",
    "description" : "cURL client",
    "license": "mit",
    "type": "library",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "phpmd/phpmd": "^2.13",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Jmf\\CurlClient\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jmf\\CurlClient\\": "tests"
        }
    }
}
